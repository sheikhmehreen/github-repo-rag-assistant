# Application
APP_ENV=development
APP_NAME=GitHub Repo RAG Assistant

# GitHub (optional, raises API rate limits)
GITHUB_TOKEN=

# Storage
DATA_DIR=./data
CHROMA_DB_DIR=./data/chroma_db
DATABASE_URL=sqlite:///./data/repos.db

# Embeddings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
CHROMA_PERSIST_DIR=data/chroma
MAX_CHUNKS_PER_REPO=5000
EMBEDDING_BATCH_SIZE=64
SQLITE_PATH=data/repos.db
INGESTION_TIMEOUT_SECONDS=300
INGESTION_MAX_REPO_SIZE_KB=51200
INGESTION_MAX_CHUNKS=20000
INGESTION_TEMP_DIR=data/tmp

# LLM
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
HOSTED_LLM_BASE_URL=https://api.groq.com/openai/v1
HOSTED_LLM_MODEL=
HOSTED_LLM_API_KEY=
RETRIEVAL_MIN_SIMILARITY=0.29
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=512
MAX_QUESTION_CHARS=1000
MAX_PROMPT_CHARS=12000

# API
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
