# Application
APP_ENV=development
APP_NAME=GitHub Repo RAG Assistant

# GitHub (optional, raises API rate limits)
GITHUB_TOKEN=

# Storage
DATA_DIR=./data
CHROMA_DB_DIR=./data/chroma_db
DATABASE_URL=sqlite:///./data/repos.db

# Embeddings
EMBEDDING_MODEL=nomic-embed-text

# LLM
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_API_KEY=

# API
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
