# Application
APP_NAME=GitHub Repo RAG Assistant
APP_ENV=development
DEBUG=false

# Repository limits
MAX_REPO_SIZE_MB=50
MAX_FILES=2000
MAX_FILE_SIZE_KB=500

# Chunking (tokens)
CHUNK_SIZE=200
CHUNK_OVERLAP=30

# Retrieval
TOP_K=5
MAX_QUESTION_LENGTH=1000
RETRIEVAL_SCORE_THRESHOLD=0.35

# Timeouts (seconds)
GITHUB_API_TIMEOUT_SECONDS=15
REPO_DOWNLOAD_TIMEOUT_SECONDS=60
INGESTION_TIMEOUT_SECONDS=120
LLM_TIMEOUT_SECONDS=60

# GitHub (leave blank for public repos at low volume)
GITHUB_TOKEN=

# LLM
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_BASE_URL=http://localhost:11434
LLM_MAX_OUTPUT_TOKENS=512
LLM_MAX_RETRIES=2

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage (optional; relative paths are resolved against backend/)
# DATA_DIR=data
# TEMP_DIR=data/temp
# CHROMA_DIR=data/chroma
# SQLITE_DB_PATH=data/repositories.db
# MODEL_CACHE_DIR=data/models
